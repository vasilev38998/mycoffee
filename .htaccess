Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Cheaply reject the most common automated reconnaissance targets before
  # they reach PHP or the PWA rewrite. These names are not Kapouch routes.
  RewriteRule ^(?:phpinfo|info|php-info|phpversion|old_phpinfo|server-info|server-status|debug|test|php|pi|p|i)(?:\.php)?(?:\.(?:bak|old|save|orig|swp))?/?$ - [F,L,NC]
  RewriteRule ^(?:\.env(?:\..*)?|\.git(?:/|$)|\.svn(?:/|$)|composer\.(?:json|lock)|vendor/phpunit(?:/|$)|wp-login\.php|wp-admin(?:/|$)|wp-config\.php(?:\..*)?) - [F,L,NC]

  # Physical Evotor OS 4.x can reach kapouch.store over the reviewed legacy TLS
  # path but the hosting edge may reject direct /api/*.php calls. Keep terminal
  # transport endpoints extensionless and rewrite them internally to PHP.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?kapouch\.store(?::[0-9]+)?$ [NC]
  RewriteRule ^evotor-bridge/?$ api/evotor_bridge.php [L,NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?kapouch\.store(?::[0-9]+)?$ [NC]
  RewriteRule ^evotor-loyalty-discount/?$ api/evotor_loyalty_discount.php [L,NC]

  # app.kapouch.store is attached to this same Beget site, but is allowed to
  # serve only the public customer PWA. This is an internal rewrite: the
  # browser keeps the clean https://app.kapouch.store/ URL.
  RewriteCond %{HTTP_HOST} ^app\.kapouch\.store(?::[0-9]+)?$ [NC]
  RewriteCond %{REQUEST_URI} !^/customer(?:/|$) [NC]
  RewriteRule ^(.*)$ customer/$1 [L]

  RewriteRule ^(?:inc|database|docs|cron)(?:/|$) - [F,L,NC]
</IfModule>

<FilesMatch "^(config\.php|config\.example\.php|README\.md)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(?:sql|md)$">
  Require all denied
</FilesMatch>
<FilesMatch "(?i)(?:^\.|\.(?:bak|old|orig|save|swp)$|~$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>
